# Railway sets DATABASE_URL automatically when you reference the Postgres service.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/iwatpos
# Long random string used to sign sign-in tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me
# Time zone used for daily and hourly reports.
APP_TZ=Africa/Kampala
# Set to false to start with an empty database (no demo businesses).
SEED_DEMO=true
PORT=3000
