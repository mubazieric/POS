{
  "name": "iwat-pos",
  "version": "1.0.0",
  "private": true,
  "description": "IWAT POS — offline-first point of sale for restaurants, cafés and retail",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client ci && npm --prefix client run build",
    "start": "node server/index.js",
    "reset-demo": "node server/reset.js"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "compression": "1.7.4",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.13.0"
  }
}
